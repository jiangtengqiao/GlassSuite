<UserControl x:Class="GlassSuite.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
            <!-- 推荐 -->
            <TabItem Header="推荐">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="每日推荐" FontWeight="Bold" FontSize="15" Margin="16,10,0,4" />
                        <ItemsControl x:Name="DailyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,4" Background="Transparent" Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IndexText}" Foreground="#999999" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                            <TextBlock Text="{Binding ArtistText}" FontSize="12" Foreground="#999999" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#BBBBBB" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="推荐歌单" FontWeight="Bold" FontSize="15" Margin="16,14,0,4" />
                        <ItemsControl x:Name="RecommendList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="150" Margin="8,4" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding Id}"
                                                          Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel.InputBindings>
                                        <Border Background="#F0F0F0" CornerRadius="8">
                                            <Image Source="{Binding CoverImgUrl}" Height="140" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding PlayCountText}" FontSize="11" Foreground="#999999" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="新歌速递" FontWeight="Bold" FontSize="15" Margin="16,14,0,4" />
                        <ItemsControl x:Name="NewSongList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,4" Background="Transparent" Cursor="Hand">
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.PlaySongCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IndexText}" Foreground="#999999" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                            <TextBlock Text="{Binding ArtistText}" FontSize="12" Foreground="#999999" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#BBBBBB" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 排行榜 -->
            <TabItem Header="排行榜">
                <ListBox x:Name="ToplistBox" SelectionChanged="ToplistBox_SelectionChanged" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,6" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding CoverImgUrl}" Width="52" Height="52" Stretch="UniformToFill" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdateFrequency}" FontSize="11" Foreground="#999999" />
                                    <TextBlock Text="{Binding PlayCountText}" FontSize="11" Foreground="#999999" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- 歌单广场 -->
            <TabItem Header="歌单广场">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="44">
                        <ItemsControl x:Name="CatList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="4,6" Padding="12,4" Click="CatBtn_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SquareList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="150" Margin="8,4" Cursor="Hand">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding Id}"
                                                          Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel.InputBindings>
                                        <Border Background="#F0F0F0" CornerRadius="8">
                                            <Image Source="{Binding CoverImgUrl}" Height="140" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding PlayCountText}" FontSize="11" Foreground="#999999" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
