<UserControl x:Class="GlassSuite.Views.BetaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- 左：申请要求 -->
        <StackPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock Text="开发者尝鲜模式" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="ReqIntro" FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
            <ItemsControl x:Name="ReqList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ReqNote" FontSize="11" Foreground="#E8890C" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <!-- 右：申请表单 + 激活 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="提交申请（实时达标评估，≥60 分通过）" FontSize="14" FontWeight="SemiBold" />
                <TextBox x:Name="EmailBox" Height="30" Margin="0,8,0,0" ToolTip="邮箱" />
                <TextBox x:Name="NameBox" Height="30" Margin="0,8,0,0" ToolTip="姓名/昵称" />
                <ComboBox x:Name="PurposeBox" Margin="0,8,0,0">
                    <ComboBoxItem Content="开发者" />
                    <ComboBoxItem Content="测试" />
                    <ComboBoxItem Content="媒体评测" />
                    <ComboBoxItem Content="普通体验" />
                </ComboBox>
                <TextBox x:Name="ReasonBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,8,0,0" ToolTip="申请理由（不少于 15 字）" />
                <TextBox x:Name="DeviceBox" Height="30" Margin="0,8,0,0" ToolTip="设备信息" />
                <Button Content="提交申请" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="Apply_Click" />

                <Border x:Name="ResultPanel" Background="#F9F9FB" CornerRadius="10" Margin="0,12,0,0" Padding="14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultStatus" FontSize="14" FontWeight="Bold" />
                        <TextBlock x:Name="ResultScore" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                        <TextBlock x:Name="ResultKey" FontSize="13" FontWeight="Bold" Foreground="#C62F2F" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <ItemsControl x:Name="ResultReasons">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#E84026" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ResultMsg" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Separator Margin="0,14" />
                <TextBlock Text="已有尝鲜码？输入激活（22~37 位）" FontSize="14" FontWeight="SemiBold" />
                <TextBox x:Name="KeyBox" Height="30" Margin="0,8,0,0" ToolTip="尝鲜码" />
                <Button Content="激活尝鲜码" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="Verify_Click" />
                <TextBlock x:Name="ActivateMsg" FontSize="12" Foreground="#00B578" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
