<Window x:Class="GlassSuite.Views.MvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MV 播放" Width="920" Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <vlc:VideoView x:Name="VideoView" Background="Black" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="14,10" FontSize="13"
                   Foreground="{StaticResource SubTextBrush}" />
    </Grid>
</Window>
