<UserControl x:Class="GlassSuite.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="34" FontSize="14" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="SearchBtn_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid x:Name="HotPanel" Visibility="Visible">
                <WrapPanel>
                    <TextBlock Text="热搜：" FontSize="13" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding HotWords}" Margin="8,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource NavButton}" Click="HotWord_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </Grid>

            <Grid x:Name="ResultPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabControl x:Name="ResultTabs" Grid.Row="0">
                    <TabItem Header="单曲">
                        <ListBox x:Name="SongList" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="SongList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IndexText}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                            <TextBlock Text="{Binding ArtistNames}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding AlbumName}" FontSize="12"
                                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12"
                                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="歌单">
                        <ListBox x:Name="PlaylistList" MouseDoubleClick="PlaylistList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding CoverImgUrl}" Width="40" Height="40" Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                            <TextBlock Text="{Binding CreatorNickname}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TrackCountText}" FontSize="12"
                                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="歌手">
                        <ListBox x:Name="ArtistList" MouseDoubleClick="ArtistList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding PicUrl}" Width="40" Height="40" Stretch="UniformToFill" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="专辑">
                        <ListBox x:Name="AlbumList" MouseDoubleClick="AlbumList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding PicUrl}" Width="40" Height="40" Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                            <TextBlock Text="{Binding ArtistName}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="MV">
                        <ListBox x:Name="MvList" MouseDoubleClick="MvList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Cover}" Width="40" Height="40" Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                            <TextBlock Text="{Binding ArtistName}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12"
                                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
