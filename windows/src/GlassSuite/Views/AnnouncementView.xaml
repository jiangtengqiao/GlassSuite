<UserControl x:Class="GlassSuite.Views.AnnouncementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="公告与推送" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="公告文件 · 推广信息 · 点击跳转" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,12" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AnnouncementList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F9F9FB" CornerRadius="10" Margin="0,6" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#3D7FFF" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="公告" FontSize="10" Foreground="White" />
                                </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Date}" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Content}" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="查看详情 ›" FontSize="12" FontWeight="Bold" Foreground="#C62F2F"
                                           Margin="0,8,0,0" Cursor="Hand" Visibility="{Binding IsLinkVisible}">
                                        <TextBlock.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
