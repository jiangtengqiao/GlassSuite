<UserControl x:Class="GlassSuite.Views.HomeCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Aura" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="  GlassSuite" FontSize="22" Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Bottom" Margin="8,0,0,3" />
                <TextBlock Text="v1.1.0-beta.1" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Bottom" Margin="12,0,0,5" />
                <Border Background="#E8890C" CornerRadius="6" Padding="6,1" Margin="8,0,0,4" VerticalAlignment="Bottom">
                    <TextBlock Text="BETA 尝鲜版" FontSize="10" Foreground="White" />
                </Border>
            </StackPanel>
            <TextBlock Text="多功能应用套件 · 音乐 / GitHub 检索 / 更新中心 / 公告推送"
                       FontSize="13" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,24" />

            <TextBlock x:Name="AnnouncementBar" FontSize="13" Foreground="#E8890C"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="功能模块" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" CornerRadius="14" Background="#FFF5F5" Padding="18" Margin="0,0,8,8" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenMusicCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="♪ 音乐" FontSize="16" FontWeight="Bold" Foreground="#EC4141" />
                        <TextBlock Text="网易云音乐 · 播放/歌词/歌单/锁屏" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" CornerRadius="14" Background="#F0F5FF" Padding="18" Margin="8,0,0,8" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenGitHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="⌥ GitHub 检索" FontSize="16" FontWeight="Bold" Foreground="#3D7FFF" />
                        <TextBlock Text="搜索仓库 · 热门趋势" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" CornerRadius="14" Background="#EEFFF6" Padding="18" Margin="0,8,8,8" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenUpdatesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻ 更新中心" FontSize="16" FontWeight="Bold" Foreground="#00B578" />
                        <Border x:Name="UpdateBadge" Background="#EC4141" CornerRadius="8" Padding="6,2"
                                Margin="8,0,0,0" Visibility="Collapsed">
                            <TextBlock Text=" 有新版本" FontSize="11" Foreground="White" />
                        </Border>
                    </StackPanel>
                        <TextBlock Text="自查更新 · 折叠日志 · 下载" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" CornerRadius="14" Background="#FFF7E8" Padding="18" Margin="8,8,0,8" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenAnnouncementsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="📢 公告与推送" FontSize="16" FontWeight="Bold" Foreground="#FF8000" />
                        <TextBlock Text="公告文件 · 推广信息 · 自动推送" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" CornerRadius="14" Background="#F6F0FF" Padding="18" Margin="0,8,8,0" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border.InputBindings>
                    <StackPanel>
                        <TextBlock Text="⚙ 设置" FontSize="16" FontWeight="Bold" Foreground="#7B5CFF" />
                        <TextBlock Text="主题 · 服务器 · GitHub 仓库" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="© 2026 GlassSuite · 多功能应用套件" FontSize="11" Foreground="#BBBBBB" Margin="0,28,0,16" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
