<UserControl x:Class="GlassSuite.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="连接方式" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="DirectBtn" Content="自动直连网易云（推荐）" Click="DirectMode_Click" Tag="true" Margin="0,0,8,0" />
                <Button x:Name="ServerBtn" Content="自托管服务器" Click="DirectMode_Click" Tag="false" />
            </StackPanel>
            <TextBlock x:Name="ModeHint" FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap" />

            <TextBlock Text="服务器" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0" />
            <StackPanel x:Name="ServerPanel">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ApiBox" Height="32" FontSize="13" />
                    <Button Grid.Column="1" Content="保存并应用" Margin="10,0,0,0" Click="SaveApi_Click" />
                </Grid>
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Text="主题定制" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Tag="#EC4141" Click="Accent_Click" Width="34" Height="34" Background="#EC4141" Margin="0,0,10,0" ToolTip="网易红" />
                <Button Tag="#C62F2F" Click="Accent_Click" Width="34" Height="34" Background="#C62F2F" Margin="0,0,10,0" ToolTip="绯红" />
                <Button Tag="#00B578" Click="Accent_Click" Width="34" Height="34" Background="#00B578" Margin="0,0,10,0" ToolTip="薄荷绿" />
                <Button Tag="#3D7FFF" Click="Accent_Click" Width="34" Height="34" Background="#3D7FFF" Margin="0,0,10,0" ToolTip="海盐蓝" />
                <Button Tag="#7B5CFF" Click="Accent_Click" Width="34" Height="34" Background="#7B5CFF" Margin="0,0,10,0" ToolTip="暗夜紫" />
                <Button Tag="#FF8000" Click="Accent_Click" Width="34" Height="34" Background="#FF8000" Margin="0,0,10,0" ToolTip="琥珀橙" />
            </StackPanel>
            <CheckBox x:Name="DarkModeBox" Content="深色模式" IsChecked="{Binding DarkMode}" Margin="0,10,0,0"
                      Checked="DarkMode_Checked" Unchecked="DarkMode_Checked" />

            <TextBlock Text="歌词设置" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Tag="0" Click="Mode_Click" Content="原词" Margin="0,0,8,0" />
                <Button Tag="1" Click="Mode_Click" Content="翻译" Margin="0,0,8,0" />
                <Button Tag="2" Click="Mode_Click" Content="罗马音" Margin="0,0,8,0" />
                <Button Tag="3" Click="Mode_Click" Content="DIY" Margin="0,0,8,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="时间偏移：" VerticalAlignment="Center" />
                <Button Content="−0.5s" Click="OffsetMinus_Click" Margin="8,0" />
                <TextBlock Text="{Binding LyricOffsetText}" VerticalAlignment="Center" FontSize="13" />
                <Button Content="+0.5s" Click="OffsetPlus_Click" Margin="8,0" />
                <Button Content="复位" Click="OffsetReset_Click" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="字号：" VerticalAlignment="Center" />
                <Button Content="−" Click="FontMinus_Click" Margin="8,0" Width="32" />
                <TextBlock Text="{Binding LyricFontSize}" VerticalAlignment="Center" FontSize="13" />
                <Button Content="+" Click="FontPlus_Click" Margin="8,0" Width="32" />
            </StackPanel>
            <TextBox x:Name="DiyBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,10,0,0"
                     ToolTip="粘贴 LRC 格式歌词（DIY）" />
            <Button Content="应用 DIY 歌词" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Click="SaveDiy_Click" />

            <TextBlock Text="开发者尝鲜" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0" />
            <Button Content="开发者尝鲜模式（申请/激活尝鲜码）" HorizontalAlignment="Left" Click="Beta_Click" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BetaUrlBox" Height="30" FontSize="12" ToolTip="Beta 服务器地址" />
                <Button Grid.Column="1" Content="保存" Margin="10,0,0,0" Click="SaveBetaUrl_Click" />
            </Grid>

            <TextBlock Text="错误上报" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0" />
            <TextBlock Text="崩溃与异常自动采集（含系统与版本信息），启动时自动上传，失败自动保留并重试。"
                       FontSize="12" Foreground="#888888" Margin="0,6,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="查看日志" Click="ErrLog_Click" Margin="0,0,8,0" />
                <Button Content="手动上传" Click="ErrUpload_Click" Margin="0,0,8,0" />
                <Button Content="清空" Click="ErrClear_Click" />
            </StackPanel>
            <TextBlock x:Name="ErrStatus" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
            <TextBox x:Name="ErrBox" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" Visibility="Collapsed" />

            <TextBlock Text="关于与法律" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0" />
            <StackPanel Margin="0,8,0,0">
                <Button Tag="01-用户协议.txt" Click="LegalDoc_Click" Content="用户协议" HorizontalAlignment="Left" />
                <Button Tag="02-隐私政策.txt" Click="LegalDoc_Click" Content="隐私政策" HorizontalAlignment="Left" />
                <Button Tag="03-儿童个人信息保护规则.txt" Click="LegalDoc_Click" Content="儿童个人信息保护规则" HorizontalAlignment="Left" />
                <Button Tag="04-版权声明与侵权投诉.txt" Click="LegalDoc_Click" Content="版权声明与侵权投诉" HorizontalAlignment="Left" />
                <Button Tag="05-免责声明.txt" Click="LegalDoc_Click" Content="免责声明" HorizontalAlignment="Left" />
                <Button Tag="06-第三方SDK与权限清单.txt" Click="LegalDoc_Click" Content="第三方SDK与权限清单" HorizontalAlignment="Left" />
                <Button Tag="07-账号注销指引.txt" Click="LegalDoc_Click" Content="账号注销指引" HorizontalAlignment="Left" />
                <Button Tag="08-投诉与举报.txt" Click="LegalDoc_Click" Content="投诉与举报" HorizontalAlignment="Left" />
                <Button Tag="09-用户行为规范.txt" Click="LegalDoc_Click" Content="用户行为规范" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Text="璃光 GlassSuite v1.1.0 · 仅供学习交流使用"
                       FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,24,0,12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
