<UserControl x:Class="GlassSuite.Views.UpdateCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="更新中心" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="实时自查更新 · 点击条目展开更新日志" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,10" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,10" Background="#F7F7F9" CornerRadius="10">
            <StackPanel Margin="14">
                <TextBlock Text="当前版本：v1.1.0" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdateStatus" Text="尚未检查更新（启动后自动检查）" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="立即检查" Style="{StaticResource PrimaryButton}" Click="Check_Click" />
                    <Button x:Name="DownloadBtn" Content="前往 Releases 下载" Margin="10,0,0,0" Click="Download_Click"
                            Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="更新日志" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" VerticalAlignment="Top" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,28,0,0">
            <ItemsControl ItemsSource="{Binding ReleaseRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F9F9FB" CornerRadius="10" Margin="0,4" Padding="12" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ToggleReleaseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TagName}" FontSize="13" FontWeight="Bold" />
                                    <Border Background="#FF8000" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" Visibility="{Binding Prerelease}">
                                        <TextBlock Text="pre" FontSize="9" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="  ▼" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PublishedAt}" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Body}" FontSize="12" Foreground="#555555" TextWrapping="Wrap"
                                           Visibility="{Binding IsExpanded}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
