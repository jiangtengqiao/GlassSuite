<Window x:Class="GlassSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:GlassSuite.Controls"
        Title="璃光 GlassSuite" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F9">
    <DockPanel>
        <!-- 左导航 -->
        <Border x:Name="NavPanel" DockPanel.Dock="Left" Width="92" Background="#2B2B30">
            <StackPanel>
                <TextBlock Text="璃光" FontSize="22" FontWeight="Bold" Foreground="#EC4141"
                           HorizontalAlignment="Center" Margin="0,20,0,24" />
                <Button x:Name="NavCenterBtn" Style="{StaticResource NavButton}" Foreground="White" Content="首页"
                        Click="NavCenter_Click" />
                <Button x:Name="NavHomeBtn" Style="{StaticResource NavButton}" Foreground="White" Content="发现"
                        Click="NavHome_Click" />
                <Button x:Name="NavSearchBtn" Style="{StaticResource NavButton}" Foreground="White" Content="搜索"
                        Click="NavSearch_Click" />
                <Button x:Name="NavUserBtn" Style="{StaticResource NavButton}" Foreground="White" Content="我的"
                        Click="NavUser_Click" />
                <Button x:Name="NavSettingsBtn" Style="{StaticResource NavButton}" Foreground="White" Content="设置"
                        Click="NavSettings_Click" />
                <TextBlock Text="{Binding WindowTitle}" FontSize="10" Foreground="#888888"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="8,24,8,0" />
            </StackPanel>
        </Border>

        <!-- 歌词面板 -->
        <Border x:Name="LyricPanel" DockPanel.Dock="Right" Width="330" Background="#FFFFFF" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Background="#F7F7F9">
                    <TextBlock Text="歌词" FontSize="15" FontWeight="Bold" Margin="12,10" />
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            Background="Transparent" Click="LyricClose_Click" />
                </Grid>
                <ctl:LyricControl x:Name="LyricCtrl" Grid.Row="1" FontSize="18" />
            </Grid>
        </Border>

        <!-- 底部播放条 -->
        <Border x:Name="PlayerBar" DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding CurrentSong.AlbumPic}" Width="46" Height="46" Stretch="UniformToFill" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSong.Name}" FontSize="13" FontWeight="SemiBold" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentSong.ArtistNames}" FontSize="11"
                                   Foreground="{StaticResource SubTextBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <Button x:Name="ModeBtn" Content="顺序" Background="Transparent" Click="Mode_Click" />
                    <Button Content="⏮" FontSize="16" Background="Transparent" Click="Prev_Click" />
                    <Button x:Name="PlayBtn" Content="▶" FontSize="22" Foreground="{StaticResource AccentBrush}"
                            Background="Transparent" Click="Play_Click" />
                    <Button Content="⏭" FontSize="16" Background="Transparent" Click="Next_Click" />
                    <Button x:Name="ShuffleBtn" Content="列表" Background="Transparent" Click="Shuffle_Click" />
                    <Button Content="队列" Background="Transparent" Click="Queue_Click" />
                </StackPanel>

                <Grid Grid.Column="2" Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" ValueChanged="ProgressSlider_ValueChanged" />
                    <Grid Grid.Row="1" Margin="0,2,0,0">
                        <TextBlock x:Name="PositionText" FontSize="11" Foreground="{StaticResource SubTextBrush}" />
                        <TextBlock x:Name="DurationText" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LikeBtn" Content="♡" FontSize="18" Background="Transparent" Click="Like_Click" />
                    <Button Content="歌词" Background="Transparent" Click="LyricToggle_Click" />
                    <Button x:Name="QualityBtn" Content="极高" Background="Transparent" Click="Quality_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid>
            <ContentControl x:Name="ContentHost" />
        </Grid>
    </DockPanel>
</Window>
