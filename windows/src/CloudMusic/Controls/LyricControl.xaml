<UserControl x:Class="CloudMusic.Controls.LyricControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden">
        <ItemsControl x:Name="Items">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock x:Name="LineText"
                               Text="{Binding Text}"
                               TextAlignment="Center"
                               Foreground="#888888"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                               TextWrapping="Wrap"
                               Padding="24,6"
                               Cursor="Hand" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
